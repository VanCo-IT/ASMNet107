@model WebCafePoly.Models.PhieuBanHang

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Tạo phiếu bán hàng";
}

<div class="invoice-admin-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / Phiếu bán hàng / <strong>Tạo phiếu</strong>
            </div>

            <h1 class="mb-1">
                Tạo phiếu bán hàng
            </h1>

            <p class="text-body-secondary mb-0">
                Tạo phiếu bán hàng mới cho hệ thống.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại
        </a>

    </div>


    <!-- FORM -->
    <div class="card">

        <div class="card-header">
            <strong>Thông tin phiếu bán hàng</strong>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>


                <div class="row">

                    <!-- MÃ PHIẾU -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Mã phiếu
                        </label>

                        <input class="form-control"
                               value="Hệ thống tự động tạo"
                               disabled />

                        <div class="form-text">
                            Mã phiếu sẽ được hệ thống tự sinh.
                        </div>

                    </div>


                    <!-- KHÁCH HÀNG -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="MaKhachHang"
                               class="form-label">
                            Mã khách hàng
                        </label>

                        <input asp-for="MaKhachHang"
                               class="form-control"
                               placeholder="Ví dụ: KH001" />

                        <span asp-validation-for="MaKhachHang"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- MÃ THẺ -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="MaThe"
                               class="form-label">
                            Mã thẻ
                        </label>

                        <input asp-for="MaThe"
                               class="form-control"
                               placeholder="Nhập mã thẻ nếu có" />

                        <span asp-validation-for="MaThe"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- NHÂN VIÊN -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="MaNhanVien"
                               class="form-label">
                            Mã nhân viên
                        </label>

                        <input asp-for="MaNhanVien"
                               class="form-control"
                               placeholder="Ví dụ: NV001" />

                        <span asp-validation-for="MaNhanVien"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- NGÀY TẠO -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="NgayTao"
                               class="form-label">
                            Ngày tạo
                        </label>

                        <input asp-for="NgayTao"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="NgayTao"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- TRẠNG THÁI -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="TrangThai"
                               class="form-label">
                            Trạng thái
                        </label>

                        <select asp-for="TrangThai"
                                class="form-select">

                            <option value="false">
                                Chưa hoàn thành
                            </option>

                            <option value="true">
                                Hoàn thành
                            </option>

                        </select>

                        <span asp-validation-for="TrangThai"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- BUTTON -->
                <div class="d-flex justify-content-end gap-2 mt-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <span class="me-1">＋</span>
                        Tạo phiếu bán
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}