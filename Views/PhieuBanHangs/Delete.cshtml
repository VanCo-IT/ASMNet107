@model WebCafePoly.Models.PhieuBanHang

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa phiếu bán hàng";
}

<div class="invoice-admin-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / Phiếu bán hàng / <strong>Xóa</strong>
            </div>

            <h1 class="mb-1">
                Xóa phiếu bán hàng
            </h1>

            <p class="text-body-secondary mb-0">
                Kiểm tra thông tin trước khi xóa phiếu.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại
        </a>

    </div>


    <!-- WARNING -->
    <div class="alert alert-danger d-flex align-items-center mb-4">

        <div>
            <strong>Cảnh báo</strong>
            <div>
                Bạn có chắc chắn muốn xóa phiếu bán hàng này không?
            </div>
        </div>

    </div>


    <!-- INFORMATION -->
    <div class="card mb-4">

        <div class="card-header">
            <strong>Thông tin phiếu bán hàng</strong>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- MÃ PHIẾU -->
                <div class="col-md-6">

                    <div class="text-body-secondary small mb-1">
                        Mã phiếu
                    </div>

                    <div class="fw-semibold fs-5">
                        @Model.MaPhieu
                    </div>

                </div>


                <!-- KHÁCH HÀNG -->
                <div class="col-md-6">

                    <div class="text-body-secondary small mb-1">
                        Mã khách hàng
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.MaKhachHang))
                    {
                        <span class="badge bg-light text-dark border fs-6">
                            @Model.MaKhachHang
                        </span>
                    }
                    else
                    {
                        <span class="text-body-secondary">
                            Không có
                        </span>
                    }

                </div>


                <!-- THẺ -->
                <div class="col-md-6">

                    <div class="text-body-secondary small mb-1">
                        Mã thẻ
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.MaThe))
                    {
                        <span class="badge bg-light text-dark border fs-6">
                            @Model.MaThe
                        </span>
                    }
                    else
                    {
                        <span class="text-body-secondary">
                            Không có
                        </span>
                    }

                </div>


                <!-- NHÂN VIÊN -->
                <div class="col-md-6">

                    <div class="text-body-secondary small mb-1">
                        Mã nhân viên
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.MaNhanVien))
                    {
                        <span class="badge bg-light text-dark border fs-6">
                            @Model.MaNhanVien
                        </span>
                    }
                    else
                    {
                        <span class="text-body-secondary">
                            Không có
                        </span>
                    }

                </div>


                <!-- NGÀY TẠO -->
                <div class="col-md-6">

                    <div class="text-body-secondary small mb-1">
                        Thời gian tạo
                    </div>

                    <div class="fw-semibold">
                        @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                    </div>

                </div>


                <!-- TRẠNG THÁI -->
                <div class="col-md-6">

                    <div class="text-body-secondary small mb-1">
                        Trạng thái
                    </div>

                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success fs-6">
                            Hoàn thành
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6">
                            Chưa hoàn thành
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- DELETE FORM -->
    <div class="d-flex justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Hủy
        </a>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="MaPhieu" />

            <button type="submit"
                    class="btn btn-danger">
                Xóa phiếu
            </button>

        </form>

    </div>

</div>