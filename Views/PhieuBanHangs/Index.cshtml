```cshtml
@model IEnumerable<WebCafePoly.Models.PhieuBanHang>

@{
    ViewData["Title"] = "Quản lý phiếu bán hàng";
}

<div class="invoice-admin-page">

    <!-- HEADER -->
    <div class="invoice-page-header">

        <div>
            <div class="page-breadcrumb">
                <span>Quản trị</span>
                <span>/</span>
                <strong>Phiếu bán hàng</strong>
            </div>

            <h1>Quản lý phiếu bán hàng</h1>

            <p>
                Theo dõi các phiếu bán hàng được tạo trong hệ thống.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-add-invoice">
            <span>＋</span>
            Tạo phiếu bán
        </a>

    </div>


    <!-- SUMMARY -->
    <div class="invoice-summary">

        <div class="invoice-summary-icon">
            🧾
        </div>

        <div>
            <span>Tổng số phiếu</span>
            <strong>@Model.Count()</strong>
        </div>

    </div>


    <!-- TABLE -->
    <div class="invoice-table-card">

        <div class="invoice-table-header">

            <div>
                <h3>Danh sách phiếu bán hàng</h3>
                <p>Thông tin các giao dịch bán hàng trong hệ thống</p>
            </div>

        </div>


        <div class="table-responsive">

            <table class="table invoice-table">

                <thead>
                    <tr>
                        <th>Phiếu bán</th>
                        <th>Khách hàng</th>
                        <th>Thẻ</th>
                        <th>Nhân viên</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- INVOICE -->
                            <td>
                                <div class="invoice-code-cell">

                                    <div class="invoice-icon">
                                        🧾
                                    </div>

                                    <div>
                                        <strong>
                                            @item.MaPhieu
                                        </strong>

                                        <small>
                                            Phiếu bán hàng
                                        </small>
                                    </div>

                                </div>
                            </td>


                            <!-- CUSTOMER -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.MaKhachHang))
                                {
                                    <span class="invoice-code">
                                        @item.MaKhachHang
                                    </span>
                                }
                                else
                                {
                                    <span class="invoice-empty">
                                        Không có
                                    </span>
                                }
                            </td>


                            <!-- CARD -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.MaThe))
                                {
                                    <span class="invoice-code">
                                        @item.MaThe
                                    </span>
                                }
                                else
                                {
                                    <span class="invoice-empty">
                                        Không có
                                    </span>
                                }
                            </td>


                            <!-- EMPLOYEE -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.MaNhanVien))
                                {
                                    <span class="invoice-code">
                                        @item.MaNhanVien
                                    </span>
                                }
                                else
                                {
                                    <span class="invoice-empty">
                                        Không có
                                    </span>
                                }
                            </td>


                            <!-- DATE -->
                            <td>
                                <span class="invoice-date">
                                    @item.NgayTao.ToString("dd/MM/yyyy")
                                </span>

                                <small class="invoice-time">
                                    @item.NgayTao.ToString("HH:mm")
                                </small>
                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (item.TrangThai == true)
                                {
                                    <span class="invoice-status status-completed">
                                        <span></span>
                                        Hoàn thành
                                    </span>
                                }
                                else
                                {
                                    <span class="invoice-status status-pending">
                                        <span></span>
                                        Chưa hoàn thành
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->
                            <td>

                                <div class="invoice-actions">

                                    <a asp-action="Details"
                                       asp-route-maphieu="@item.MaPhieu"
                                       class="invoice-action invoice-view">
                                        Xem
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-maphieu="@item.MaPhieu"
                                       class="invoice-action invoice-edit">
                                        Sửa
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-maphieu="@item.MaPhieu"
                                       class="invoice-action invoice-delete">
                                        Xóa
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
```
