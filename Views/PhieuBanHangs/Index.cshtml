@model IEnumerable<WebCafePoly.Models.PhieuBanHang>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý phiếu bán hàng";
}

<div class="invoice-admin-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / <strong>Phiếu bán hàng</strong>
            </div>

            <h1 class="mb-1">
                Quản lý phiếu bán hàng
            </h1>

            <p class="text-body-secondary mb-0">
                Theo dõi các phiếu bán hàng được tạo trong hệ thống.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <span class="me-1">＋</span>
            Tạo phiếu bán
        </a>

    </div>


    <!-- SUMMARY -->
    <div class="card mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                    <span style="font-size: 24px;">🧾</span>
                </div>

                <div>
                    <div class="text-body-secondary small">
                        Tổng số phiếu
                    </div>

                    <div class="fs-4 fw-semibold">
                        @Model.Count()
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- TABLE -->
    <div class="card">

        <div class="card-header">
            <strong>Danh sách phiếu bán hàng</strong>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Phiếu bán</th>
                            <th>Khách hàng</th>
                            <th>Thẻ</th>
                            <th>Nhân viên</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- INVOICE -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-primary bg-opacity-10 rounded
                                                    d-flex align-items-center justify-content-center
                                                    me-3"
                                             style="width: 40px; height: 40px;">

                                            <span style="font-size: 20px;">
                                                🧾
                                            </span>

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @item.MaPhieu
                                            </div>

                                            <small class="text-body-secondary">
                                                Phiếu bán hàng
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- CUSTOMER -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.MaKhachHang))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @item.MaKhachHang
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            Không có
                                        </span>
                                    }

                                </td>


                                <!-- CARD -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.MaThe))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @item.MaThe
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            Không có
                                        </span>
                                    }

                                </td>


                                <!-- EMPLOYEE -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.MaNhanVien))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @item.MaNhanVien
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            Không có
                                        </span>
                                    }

                                </td>


                                <!-- DATE -->
                                <td>

                                    <div class="fw-semibold">
                                        @item.NgayTao.ToString("dd/MM/yyyy")
                                    </div>

                                    <small class="text-body-secondary">
                                        @item.NgayTao.ToString("HH:mm")
                                    </small>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success">
                                            Hoàn thành
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Chưa hoàn thành
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-end pe-4">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Details"
                                           asp-route-maphieu="@item.MaPhieu"
                                           class="btn btn-sm btn-outline-info">
                                            Xem
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-maphieu="@item.MaPhieu"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-maphieu="@item.MaPhieu"
                                           class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>