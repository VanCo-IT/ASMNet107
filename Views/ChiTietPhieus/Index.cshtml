@model IEnumerable<WebCafePoly.Models.ChiTietPhieu>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết phiếu";
}

<div class="detail-invoice-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / <strong>Chi tiết phiếu</strong>
            </div>

            <h1 class="mb-1">
                Chi tiết phiếu
            </h1>

            <p class="text-body-secondary mb-0">
                Quản lý các sản phẩm trong từng phiếu bán hàng.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <span class="me-1">＋</span>
            Thêm chi tiết
        </a>

    </div>


    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <!-- TOTAL DETAILS -->
        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                        <span style="font-size: 24px;">#</span>
                    </div>

                    <div>
                        <div class="text-body-secondary small">
                            Tổng chi tiết
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.Count()
                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- TOTAL PRODUCTS -->
        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-info bg-opacity-10 rounded p-3 me-3">
                        <span style="font-size: 24px;">☕</span>
                    </div>

                    <div>
                        <div class="text-body-secondary small">
                            Tổng sản phẩm
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.Sum(x => x.SoLuong)
                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- TOTAL MONEY -->
        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-success bg-opacity-10 rounded p-3 me-3">
                        <span style="font-size: 24px;">$</span>
                    </div>

                    <div>
                        <div class="text-body-secondary small">
                            Tổng tiền
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.Sum(x => x.SoLuong * x.DonGia).ToString("N0") đ
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- TABLE -->
    <div class="card">

        <div class="card-header">
            <strong>Danh sách chi tiết phiếu</strong>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Mã phiếu</th>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="ps-4">

                                    <span class="badge bg-secondary">
                                        #@item.Id
                                    </span>

                                </td>


                                <!-- INVOICE CODE -->
                                <td>

                                    <span class="badge bg-light text-dark border">
                                        @item.MaPhieu
                                    </span>

                                </td>


                                <!-- PRODUCT -->
                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="bg-primary bg-opacity-10 rounded
                                                    d-flex align-items-center justify-content-center
                                                    me-3"
                                             style="width: 40px; height: 40px;">

                                            <span style="font-size: 20px;">
                                                ☕
                                            </span>

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @(item.MaSanPhamNavigation?.TenSanPham ?? item.MaSanPham)
                                            </div>

                                            <small class="text-body-secondary">
                                                @item.MaSanPham
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- QUANTITY -->
                                <td>

                                    <span class="badge bg-info">
                                        @item.SoLuong
                                    </span>

                                </td>


                                <!-- PRICE -->
                                <td>

                                    <span>
                                        @item.DonGia.ToString("N0") đ
                                    </span>

                                </td>


                                <!-- TOTAL -->
                                <td>

                                    <strong>
                                        @((item.SoLuong * item.DonGia).ToString("N0")) đ
                                    </strong>

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-end pe-4">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Xem
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>