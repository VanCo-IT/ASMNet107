@model WebCafePoly.Models.SanPham

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="mb-4">

    <div class="text-body-secondary small mb-1">
        Quản trị / Sản phẩm / <strong>Chỉnh sửa</strong>
    </div>

    <h1 class="mb-1">Sửa sản phẩm</h1>

    <p class="text-body-secondary mb-0">
        Cập nhật thông tin sản phẩm.
    </p>

</div>


<div class="card">

    <div class="card-header">
        <strong>Thông tin sản phẩm</strong>
    </div>

    <div class="card-body">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <input type="hidden" asp-for="MaSanPham" />

            <div class="row g-3">

                <!-- MÃ SẢN PHẨM -->
                <div class="col-md-6">

                    <label asp-for="MaSanPham"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="MaSanPham"
                           class="form-control"
                           readonly />

                </div>


                <!-- TÊN SẢN PHẨM -->
                <div class="col-md-6">

                    <label asp-for="TenSanPham"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TenSanPham"
                           class="form-control"
                           placeholder="Nhập tên sản phẩm" />

                    <span asp-validation-for="TenSanPham"
                          class="text-danger">
                    </span>

                </div>


                <!-- ĐƠN GIÁ -->
                <div class="col-md-6">

                    <label asp-for="DonGia"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="DonGia"
                           class="form-control"
                           placeholder="Nhập đơn giá" />

                    <span asp-validation-for="DonGia"
                          class="text-danger">
                    </span>

                </div>


                <!-- LOẠI -->
                <div class="col-md-6">

                    <label asp-for="MaLoai"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="MaLoai"
                            asp-items="ViewBag.MaLoai"
                            class="form-select">

                        <option value="">
                            -- Chọn loại sản phẩm --
                        </option>

                    </select>

                    <span asp-validation-for="MaLoai"
                          class="text-danger">
                    </span>

                </div>


                <!-- ẢNH -->
                <div class="col-12">

                    <label class="form-label fw-semibold">
                        Hình ảnh sản phẩm
                    </label>

                    <input type="file"
                           name="imageFile"
                           id="imageFile"
                           class="form-control"
                           accept="image/*" />

                    <div class="form-text">
                        Không chọn ảnh mới nếu muốn giữ ảnh hiện tại.
                    </div>


                    <!-- ẢNH HIỆN TẠI -->
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <div class="mt-3">

                            <p class="mb-2 fw-semibold">
                                Ảnh hiện tại:
                            </p>

                            <img src="~/images/products/@Model.HinhAnh"
                                 id="imagePreview"
                                 alt="@Model.TenSanPham"
                                 style="max-width:220px;
                                        max-height:220px;
                                        object-fit:cover;
                                        border-radius:10px;
                                        border:1px solid #ddd;" />

                        </div>
                    }
                    else
                    {
                        <img id="imagePreview"
                             src="#"
                             alt="Ảnh xem trước"
                             style="display:none;
                                    max-width:220px;
                                    max-height:220px;
                                    object-fit:cover;
                                    border-radius:10px;
                                    border:1px solid #ddd;" />
                    }

                </div>


                <!-- TRẠNG THÁI -->
                <div class="col-12">

                    <div class="form-check">

                        <input asp-for="TrangThai"
                               class="form-check-input" />

                        <label asp-for="TrangThai"
                               class="form-check-label">
                            Đang bán
                        </label>

                    </div>

                </div>

            </div>


            <!-- BUTTON -->
            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Lưu thay đổi
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.getElementById("imageFile").addEventListener("change", function () {

            const file = this.files[0];
            const preview = document.getElementById("imagePreview");

            if (file) {

                preview.src = URL.createObjectURL(file);
                preview.style.display = "block";

            }

        });

    </script>
}