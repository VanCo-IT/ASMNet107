@model WebCafePoly.Models.SanPham

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="mb-4">

    <div class="text-body-secondary small mb-1">
        Quản trị / Sản phẩm / <strong>Thêm mới</strong>
    </div>

    <h1 class="mb-1">Thêm sản phẩm</h1>

    <p class="text-body-secondary mb-0">
        Thêm sản phẩm mới vào danh sách của quán.
    </p>

</div>


<div class="card">

    <div class="card-header">
        <strong>Thông tin sản phẩm</strong>
    </div>

    <div class="card-body">

        <form asp-action="Create" enctype="multipart/form-data">
            @* thuộc tính dùng để upload file 
            enctype="multipart/form-data">*@

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row g-3">

                <!-- MÃ SẢN PHẨM -->
                <div class="col-md-6">

                    <label asp-for="MaSanPham"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="MaSanPham"
                           class="form-control"
                           placeholder="Nhập mã sản phẩm" />

                    <span asp-validation-for="MaSanPham"
                          class="text-danger">
                    </span>

                </div>


                <!-- TÊN SẢN PHẨM -->
                <div class="col-md-6">

                    <label asp-for="TenSanPham"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TenSanPham"
                           class="form-control"
                           placeholder="Nhập tên sản phẩm" />

                    <span asp-validation-for="TenSanPham"
                          class="text-danger">
                    </span>

                </div>


                <!-- ĐƠN GIÁ -->
                <div class="col-md-6">

                    <label asp-for="DonGia"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="DonGia"
                           class="form-control"
                           placeholder="Nhập đơn giá" />

                    <span asp-validation-for="DonGia"
                          class="text-danger">
                    </span>

                </div>


                <!-- LOẠI SẢN PHẨM -->
                <div class="col-md-6">

                    <label asp-for="MaLoai"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="MaLoai"
                            asp-items="ViewBag.MaLoai"
                            class="form-select">

                        <option value="">
                            -- Chọn loại sản phẩm --
                        </option>

                    </select>

                    <span asp-validation-for="MaLoai"
                          class="text-danger">
                    </span>

                </div>


                <!-- HÌNH ẢNH -->
                <div class="col-12">

                    <label class="form-label fw-semibold">
                        Hình ảnh sản phẩm
                    </label>

                    <input type="file"
                        name="imageFile"
                        id="imageFile"
                        class="form-control"
                        accept="image/*" />

                    <div class="form-text">
                        Chọn ảnh từ máy tính. Ảnh sẽ được lưu vào thư mục sản phẩm.
                    </div>

                    <div class="mt-3">

                        <img id="imagePreview"
                            src="#"
                            alt="Ảnh xem trước"
                            style="display:none;
                                    max-width:220px;
                                    max-height:220px;
                                    object-fit:cover;
                                    border-radius:10px;
                                    border:1px solid #ddd;" />

                    </div>

                    <span asp-validation-for="HinhAnh"
                        class="text-danger">
                    </span>

                </div>


                <!-- TRẠNG THÁI -->
                <div class="col-12">

                    <div class="form-check">

                        <input asp-for="TrangThai"
                               class="form-check-input" />

                        <label asp-for="TrangThai"
                               class="form-check-label">
                            Đang bán
                        </label>

                    </div>

                    <span asp-validation-for="TrangThai"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- BUTTONS -->
            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Thêm sản phẩm
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById("imageFile").addEventListener("change", function () {

            const file = this.files[0];
            const preview = document.getElementById("imagePreview");

            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = "block";
            } else {
                preview.src = "#";
                preview.style.display = "none";
            }

        });
    </script>
}