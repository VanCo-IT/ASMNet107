@model IEnumerable<WebCafePoly.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="product-admin-page">

    <!-- HEADER -->
    <div class="product-page-header">
        <div>
            <div class="page-breadcrumb">
                <span>Quản trị</span>
                <span>/</span>
                <strong>Sản phẩm</strong>
            </div>

            <h1>Quản lý sản phẩm</h1>
            <p>Quản lý danh sách đồ uống và sản phẩm của quán.</p>
        </div>

        <a asp-action="Create" class="btn btn-add-product">
            <span>＋</span>
            Thêm sản phẩm
        </a>
    </div>


    <!-- SEARCH -->
    <div class="product-toolbar">

        <div class="product-search">
            <span class="search-icon">⌕</span>

            <input type="text"
                   id="txtTimKiem"
                   class="form-control"
                   placeholder="Tìm kiếm theo tên sản phẩm..." />

        </div>

        <div class="product-count">
            <span>Danh sách sản phẩm</span>
        </div>

    </div>


    <!-- TABLE -->
    <div id="ketQuaTimKiem">
        <partial name="_PhanBangSanPham" model="Model" />
    </div>

</div>


@section Scripts
{
    <script>
        document.getElementById("txtTimKiem").addEventListener("keyup", function () {

            let tuKhoa = this.value;

            fetch("/SanPhams/TimKiem?timkiem=" + encodeURIComponent(tuKhoa))
                .then(response => response.text())
                .then(html => {
                    document.getElementById("ketQuaTimKiem").innerHTML = html;
                });

        });
    </script>
}