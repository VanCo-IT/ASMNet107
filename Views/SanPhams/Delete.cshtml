@model WebCafePoly.Models.SanPham

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="mb-4">

    <div class="text-body-secondary small mb-1">
        Quản trị / Sản phẩm / <strong>Xóa</strong>
    </div>

    <h1 class="mb-1">Xóa sản phẩm</h1>

    <p class="text-body-secondary mb-0">
        Kiểm tra thông tin trước khi xóa sản phẩm.
    </p>

</div>


<div class="card">

    <div class="card-header">
        <strong>Xác nhận xóa</strong>
    </div>

    <div class="card-body">

        <div class="row g-4">

            <!-- ẢNH -->
            <div class="col-md-4">

                <div class="text-center">

                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img src="~/images/products/@Model.HinhAnh"
                             alt="@Model.TenSanPham"
                             class="img-fluid rounded"
                             style="max-width:250px;
                                    max-height:250px;
                                    object-fit:cover;" />
                    }
                    else
                    {
                        <div class="border rounded p-5 text-body-secondary">
                            Không có hình ảnh
                        </div>
                    }

                </div>

            </div>


            <!-- THÔNG TIN -->
            <div class="col-md-8">

                <div class="mb-3">

                    <div class="text-body-secondary small">
                        Mã sản phẩm
                    </div>

                    <strong>
                        @Model.MaSanPham
                    </strong>

                </div>


                <div class="mb-3">

                    <div class="text-body-secondary small">
                        Tên sản phẩm
                    </div>

                    <strong>
                        @Model.TenSanPham
                    </strong>

                </div>


                <div class="mb-3">

                    <div class="text-body-secondary small">
                        Đơn giá
                    </div>

                    <strong>
                        @Model.DonGia.ToString("N0") đ
                    </strong>

                </div>


                <div class="mb-3">

                    <div class="text-body-secondary small">
                        Loại sản phẩm
                    </div>

                    <strong>
                        @(Model.MaLoaiNavigation?.TenLoai ?? Model.MaLoai)
                    </strong>

                </div>


                <div class="mb-3">

                    <div class="text-body-secondary small">
                        Trạng thái
                    </div>

                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">
                            Đang bán
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Ngừng bán
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- WARNING -->
        <div class="alert alert-warning mt-4">

            <strong>Cảnh báo:</strong>
            Bạn có chắc chắn muốn xóa sản phẩm này không?
            Thao tác này không thể hoàn tác.

        </div>


        <!-- BUTTON -->
        <div class="d-flex gap-2">

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="MaSanPham" />

                <button type="submit"
                        class="btn btn-danger">
                    Xác nhận xóa
                </button>

            </form>

            <a asp-action="Index"
               class="btn btn-secondary">
                Hủy
            </a>

        </div>

    </div>

</div>