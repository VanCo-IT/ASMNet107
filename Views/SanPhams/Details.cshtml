@model WebCafePoly.Models.SanPham

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="mb-4">

    <div class="text-body-secondary small mb-1">
        Quản trị / Sản phẩm / <strong>Chi tiết</strong>
    </div>

    <h1 class="mb-1">Chi tiết sản phẩm</h1>

    <p class="text-body-secondary mb-0">
        Xem thông tin chi tiết của sản phẩm.
    </p>

</div>


<div class="card">

    <div class="card-header">
        <strong>Thông tin sản phẩm</strong>
    </div>

    <div class="card-body">

        <div class="row g-4">

            <!-- ẢNH -->
            <div class="col-md-4">

                <div class="text-center">

                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img src="~/images/products/@Model.HinhAnh"
                             alt="@Model.TenSanPham"
                             class="img-fluid rounded"
                             style="max-width:280px;
                                    max-height:280px;
                                    object-fit:cover;" />
                    }
                    else
                    {
                        <div class="border rounded p-5 text-body-secondary">
                            Không có hình ảnh
                        </div>
                    }

                </div>

            </div>


            <!-- THÔNG TIN -->
            <div class="col-md-8">

                <div class="row g-3">

                    <!-- MÃ -->
                    <div class="col-md-6">

                        <div class="text-body-secondary small">
                            Mã sản phẩm
                        </div>

                        <strong>
                            @Model.MaSanPham
                        </strong>

                    </div>


                    <!-- TÊN -->
                    <div class="col-md-6">

                        <div class="text-body-secondary small">
                            Tên sản phẩm
                        </div>

                        <strong>
                            @Model.TenSanPham
                        </strong>

                    </div>


                    <!-- GIÁ -->
                    <div class="col-md-6">

                        <div class="text-body-secondary small">
                            Đơn giá
                        </div>

                        <strong class="text-primary">
                            @Model.DonGia.ToString("N0") đ
                        </strong>

                    </div>


                    <!-- LOẠI -->
                    <div class="col-md-6">

                        <div class="text-body-secondary small">
                            Loại sản phẩm
                        </div>

                        <strong>
                            @(Model.MaLoaiNavigation?.TenLoai ?? Model.MaLoai)
                        </strong>

                    </div>


                    <!-- TRẠNG THÁI -->
                    <div class="col-md-6">

                        <div class="text-body-secondary small">
                            Trạng thái
                        </div>

                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success">
                                Đang bán
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Ngừng bán
                            </span>
                        }

                    </div>


                    <!-- TÊN FILE -->
                    <div class="col-md-6">

                        <div class="text-body-secondary small">
                            Hình ảnh
                        </div>

                        @if (!string.IsNullOrEmpty(Model.HinhAnh))
                        {
                            <span>
                                @Model.HinhAnh
                            </span>
                        }
                        else
                        {
                            <span class="text-body-secondary">
                                Không có
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- BUTTON -->
        <div class="d-flex gap-2 mt-4 pt-3 border-top">

            <a asp-action="Edit"
               asp-route-masanpham="@Model.MaSanPham"
               class="btn btn-primary">
                Sửa sản phẩm
            </a>

            <a asp-action="Delete"
               asp-route-masanpham="@Model.MaSanPham"
               class="btn btn-danger">
                Xóa sản phẩm
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </div>

    </div>

</div>