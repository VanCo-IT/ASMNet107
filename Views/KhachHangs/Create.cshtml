@model WebCafePoly.Models.KhachHang

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm khách hàng";
}

<div class="customer-admin-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / Khách hàng / <strong>Thêm khách hàng</strong>
            </div>

            <h1 class="mb-1">
                Thêm khách hàng
            </h1>

            <p class="text-body-secondary mb-0">
                Tạo tài khoản khách hàng mới cho WebCafePoly.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Quay lại
        </a>

    </div>


    <!-- FORM -->
    <div class="card">

        <div class="card-header">
            <strong>Thông tin khách hàng</strong>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>


                <div class="row">

                    <!-- HỌ TÊN -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="HoTen" class="form-label">
                            Họ và tên
                        </label>

                        <input asp-for="HoTen"
                               class="form-control"
                               placeholder="Nhập họ và tên" />

                        <span asp-validation-for="HoTen"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- EMAIL -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Email" class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="example@email.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- SỐ ĐIỆN THOẠI -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="SoDienThoai" class="form-label">
                            Số điện thoại
                        </label>

                        <input asp-for="SoDienThoai"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <span asp-validation-for="SoDienThoai"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- MẬT KHẨU -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="MatKhau" class="form-label">
                            Mật khẩu
                        </label>

                        <div class="input-group">
                            <input asp-for="MatKhau"
                                type="password"
                                class="form-control"
                                id="matKhauInput"
                                placeholder="Nhập mật khẩu" />

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    id="toggleMatKhau">
                                Hiện
                            </button>
                        </div>

                        <span asp-validation-for="MatKhau"
                            class="text-danger small">
                        </span>

                    </div>


                    <!-- ĐỊA CHỈ -->
                    <div class="col-12 mb-3">

                        <label asp-for="DiaChi" class="form-label">
                            Địa chỉ
                        </label>

                        <input asp-for="DiaChi"
                               class="form-control"
                               placeholder="Nhập địa chỉ" />

                        <span asp-validation-for="DiaChi"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- TRẠNG THÁI -->
                    <div class="col-12 mb-3">

                        <label asp-for="TrangThai" class="form-label">
                            Trạng thái
                        </label>

                        <select asp-for="TrangThai" class="form-select">
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Đã khóa</option>
                        </select>

                        <span asp-validation-for="TrangThai"
                            class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- BUTTON -->
                <div class="d-flex justify-content-end gap-2 mt-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <span class="me-1">＋</span>
                        Thêm khách hàng
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script>
    document.getElementById("toggleMatKhau").addEventListener("click", function () {

        const input = document.getElementById("matKhauInput");

        if (input.type === "password") {
            input.type = "text";
            this.textContent = "Ẩn";
        } else {
            input.type = "password";
            this.textContent = "Hiện";
        }

    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}