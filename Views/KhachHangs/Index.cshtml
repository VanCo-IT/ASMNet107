@model IEnumerable<WebCafePoly.Models.KhachHang>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="customer-admin-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / <strong>Khách hàng</strong>
            </div>

            <h1 class="mb-1">
                Quản lý khách hàng
            </h1>

            <p class="text-body-secondary mb-0">
                Theo dõi thông tin và tài khoản khách hàng của WebCafePoly.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <span class="me-1">＋</span>
            Thêm khách hàng
        </a>

    </div>


    <!-- SUMMARY -->
    <div class="card mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                    <span style="font-size: 24px;">♙</span>
                </div>

                <div>
                    <div class="text-body-secondary small">
                        Tổng số khách hàng
                    </div>

                    <div class="fs-4 fw-semibold">
                        @Model.Count()
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- TABLE -->
    <div class="card">

        <div class="card-header">
            <strong>Danh sách khách hàng</strong>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Khách hàng</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Địa chỉ</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var avatarLetter = string.IsNullOrWhiteSpace(item.HoTen)
                                ? "?"
                                : item.HoTen.Trim().Substring(0, 1).ToUpper();

                            <tr>

                                <!-- CUSTOMER -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-primary text-white rounded-circle
                                                    d-flex align-items-center justify-content-center
                                                    me-3"
                                             style="width: 40px; height: 40px;">

                                            <strong>
                                                @avatarLetter
                                            </strong>

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @item.HoTen
                                            </div>

                                            <small class="text-body-secondary">
                                                @item.MaKhachHang
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- EMAIL -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <span>
                                            @item.Email
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            Chưa cập nhật
                                        </span>
                                    }

                                </td>


                                <!-- PHONE -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.SoDienThoai))
                                    {
                                        <span>
                                            @item.SoDienThoai
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            Chưa cập nhật
                                        </span>
                                    }

                                </td>


                                <!-- ADDRESS -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.DiaChi))
                                    {
                                        <span>
                                            @item.DiaChi
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            Chưa cập nhật
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Đã khóa
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-end pe-4">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Details"
                                           asp-route-makhachhang="@item.MaKhachHang"
                                           class="btn btn-sm btn-outline-info">
                                            Xem
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-makhachhang="@item.MaKhachHang"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-makhachhang="@item.MaKhachHang"
                                           class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>