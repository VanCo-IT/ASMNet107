@model WebCafePoly.Models.KhachHang

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa khách hàng";
}

<div class="customer-admin-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / Khách hàng / <strong>Xóa</strong>
            </div>

            <h1 class="mb-1">
                Xóa khách hàng
            </h1>

            <p class="text-body-secondary mb-0">
                Xác nhận xóa tài khoản khách hàng khỏi hệ thống.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại
        </a>

    </div>


    <!-- WARNING -->
    <div class="alert alert-danger d-flex align-items-center mb-4"
         role="alert">

        <div class="me-3" style="font-size: 24px;">
            ⚠
        </div>

        <div>
            <strong>Cảnh báo</strong>
            <div>
                Thao tác này sẽ xóa khách hàng khỏi hệ thống và không thể hoàn tác.
            </div>
        </div>

    </div>


    <!-- CUSTOMER INFO -->
    <div class="card mb-4">

        <div class="card-header">
            <strong>Thông tin khách hàng</strong>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- AVATAR -->
                <div class="col-md-3">

                    <div class="text-center">

                        <div class="bg-primary text-white rounded-circle
                                    d-flex align-items-center justify-content-center
                                    mx-auto mb-3"
                             style="width: 90px; height: 90px; font-size: 32px;">

                            @{
                                var avatarLetter = string.IsNullOrWhiteSpace(Model.HoTen)
                                    ? "?"
                                    : Model.HoTen.Trim().Substring(0, 1).ToUpper();
                            }

                            <strong>
                                @avatarLetter
                            </strong>

                        </div>

                        <h5 class="mb-1">
                            @Model.HoTen
                        </h5>

                        <div class="text-body-secondary">
                            @Model.MaKhachHang
                        </div>

                    </div>

                </div>


                <!-- INFORMATION -->
                <div class="col-md-9">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="text-body-secondary small">
                                Mã khách hàng
                            </div>

                            <div class="fw-semibold">
                                @Model.MaKhachHang
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-body-secondary small">
                                Họ và tên
                            </div>

                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.HoTen)
                                    ? "Chưa cập nhật"
                                    : Model.HoTen)
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-body-secondary small">
                                Email
                            </div>

                            <div class="fw-semibold">

                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    @Model.Email
                                }
                                else
                                {
                                    <span class="text-body-secondary">
                                        Chưa cập nhật
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-body-secondary small">
                                Số điện thoại
                            </div>

                            <div class="fw-semibold">

                                @if (!string.IsNullOrWhiteSpace(Model.SoDienThoai))
                                {
                                    @Model.SoDienThoai
                                }
                                else
                                {
                                    <span class="text-body-secondary">
                                        Chưa cập nhật
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-body-secondary small">
                                Địa chỉ
                            </div>

                            <div class="fw-semibold">

                                @if (!string.IsNullOrWhiteSpace(Model.DiaChi))
                                {
                                    @Model.DiaChi
                                }
                                else
                                {
                                    <span class="text-body-secondary">
                                        Chưa cập nhật
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="text-body-secondary small mb-1">
                                Trạng thái
                            </div>

                            @if (Model.TrangThai == true)
                            {
                                <span class="badge bg-success">
                                    Đang hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Đã khóa
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- DELETE FORM -->
    <div class="card">

        <div class="card-body">

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="MaKhachHang" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Xóa khách hàng
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>