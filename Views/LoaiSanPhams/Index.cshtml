@model IEnumerable<WebCafePoly.Models.LoaiSanPham>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý loại sản phẩm";
}

<div class="category-admin-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-body-secondary small mb-1">
                Quản trị / <strong>Loại sản phẩm</strong>
            </div>

            <h1 class="mb-1">
                Quản lý loại sản phẩm
            </h1>

            <p class="text-body-secondary mb-0">
                Quản lý các nhóm sản phẩm đang được sử dụng trong quán.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-primary">
                <span class="me-1">＋</span>
                Thêm loại sản phẩm
            </a>
        </div>

    </div>


    <!-- SUMMARY -->
    <div class="card mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                    <span style="font-size: 24px;">☕</span>
                </div>

                <div>
                    <div class="text-body-secondary small">
                        Tổng số loại sản phẩm
                    </div>

                    <div class="fs-4 fw-semibold">
                        @Model.Count()
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- TABLE -->
    <div class="card">

        <div class="card-header">
            <strong>Danh sách loại sản phẩm</strong>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Mã loại</th>
                            <th>Tên loại</th>
                            <th>Ghi chú</th>
                            <th class="text-center">Sản phẩm</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- MÃ LOẠI -->
                                <td class="ps-4">
                                    <span class="badge bg-primary">
                                        @item.MaLoai
                                    </span>
                                </td>


                                <!-- TÊN LOẠI -->
                                <td>
                                    <strong>
                                        @item.TenLoai
                                    </strong>
                                </td>


                                <!-- GHI CHÚ -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                    {
                                        <span>
                                            @item.GhiChu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            Chưa có ghi chú
                                        </span>
                                    }

                                </td>


                                <!-- SỐ SẢN PHẨM -->
                                <td class="text-center">

                                    <span class="badge bg-info">
                                        @(item.SanPhams?.Count ?? 0)
                                    </span>

                                </td>


                                <!-- ACTION -->
                                <td class="text-end pe-4">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Details"
                                           asp-route-maloai="@item.MaLoai"
                                           class="btn btn-sm btn-outline-info">
                                            Xem
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-maloai="@item.MaLoai"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-maloai="@item.MaLoai"
                                           class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>