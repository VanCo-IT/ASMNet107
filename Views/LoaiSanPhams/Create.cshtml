@model WebCafePoly.Models.LoaiSanPham

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm loại sản phẩm";
}

<div class="mb-4">

    <div class="text-body-secondary small mb-1">
        Quản trị / Loại sản phẩm / <strong>Thêm mới</strong>
    </div>

    <h1 class="mb-1">
        Thêm loại sản phẩm
    </h1>

    <p class="text-body-secondary mb-0">
        Tạo một loại sản phẩm mới cho hệ thống.
    </p>

</div>


<div class="card">

    <div class="card-header">
        <strong>Thông tin loại sản phẩm</strong>
    </div>

    <div class="card-body">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- MÃ LOẠI -->
            <div class="mb-3">

                <label asp-for="MaLoai"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="MaLoai"
                       class="form-control"
                       placeholder="Nhập mã loại sản phẩm" />

                <span asp-validation-for="MaLoai"
                      class="text-danger">
                </span>

            </div>


            <!-- TÊN LOẠI -->
            <div class="mb-3">

                <label asp-for="TenLoai"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="TenLoai"
                       class="form-control"
                       placeholder="Nhập tên loại sản phẩm" />

                <span asp-validation-for="TenLoai"
                      class="text-danger">
                </span>

            </div>


            <!-- GHI CHÚ -->
            <div class="mb-4">

                <label asp-for="GhiChu"
                       class="form-label fw-semibold">
                </label>

                <textarea asp-for="GhiChu"
                          class="form-control"
                          rows="4"
                          placeholder="Nhập ghi chú nếu có"></textarea>

                <span asp-validation-for="GhiChu"
                      class="text-danger">
                </span>

            </div>


            <!-- BUTTONS -->
            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Thêm loại sản phẩm
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}