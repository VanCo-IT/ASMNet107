@model WebCafePoly.Models.SanPham

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = Model.TenSanPham;
}

<section class="detail-page">
    <div class="container">
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Quay lại thực đơn</a>
        <div class="detail-card">
            <div class="detail-image">
                <img src="~/images/products/@Model.HinhAnh" alt="@Model.TenSanPham" />
            </div>
            <div class="detail-info">
                <span class="section-eyebrow">@Model.MaLoaiNavigation.TenLoai</span>
                <h1>@Model.TenSanPham</h1>
                <div class="detail-price">@String.Format("{0:N0} VNĐ", Model.DonGia)</div>
                <p class="detail-description">Một lựa chọn thơm ngon được chuẩn bị dành riêng cho những phút giây thư giãn của bạn.</p>
                @if (Model.TrangThai)
                {
                    <a asp-controller="Customer" asp-action="ThemVaoGio" asp-route-id="@Model.MaSanPham" class="detail-order">
                        THÊM VÀO GIỎ <i class="bi bi-bag-plus"></i>
                    </a>
                }
                else
                {
                    <span class="detail-stop">Món hiện đang ngừng bán</span>
                }
            </div>
        </div>
    </div>
</section>
