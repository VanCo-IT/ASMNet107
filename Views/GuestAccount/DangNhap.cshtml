@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page">
    <div class="container py-5">

        <div class="auth-card">

            <div class="auth-icon">
                <i class="bi bi-person-circle"></i>
            </div>

            <h1>Đăng nhập</h1>
            <p>Đăng nhập để đặt món và quản lý đơn hàng</p>

            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Loi
                </div>
            }

            <form asp-action="DangNhap" method="post">

                <div class="mb-3 text-start">
                    <label class="form-label">Email</label>
                    <input type="email"
                           name="email"
                           class="form-control"
                           value="@ViewBag.Email"
                           required />
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password"
                           name="matKhau"
                           class="form-control"
                           required />
                </div>

                <div class="form-check text-start mb-4">
                    <input class="form-check-input"
                           type="checkbox"
                           id="remember"
                           name="remember"
                           value="true" />

                    <label class="form-check-label" for="remember">
                        Ghi nhớ Email
                    </label>
                </div>

                <button type="submit" class="btn btn-order w-100">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Đăng nhập
                </button>

            </form>

            <div class="auth-footer">
                Chưa có tài khoản?
                <a asp-controller="GuestAccount"
                   asp-action="DangKy">
                    Đăng ký ngay
                </a>
            </div>

        </div>

    </div>
</section>