@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebCafePoly</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="customer-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="customer-logo" asp-controller="Guest" asp-action="Index">
                    <span class="logo-mark"><i class="bi bi-cup-hot-fill"></i></span>
                    <span>WebCafe<span>Poly</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNavbar">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse navbar-collapse" id="customerNavbar">
                    <ul class="navbar-nav mx-auto customer-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Guest" asp-action="Index">TRANG CHỦ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#menu">THỰC ĐƠN</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#about">VỀ CHÚNG TÔI</a>
                        </li>
                    </ul>

                    <div class="customer-account">
                        @if (Context.Session.GetString("MaKhachHang") != null)
                        {
                            <a class="customer-icon-link" asp-controller="Customer" asp-action="GioHang" title="Giỏ hàng">
                                <i class="bi bi-bag"></i>
                            </a>

                            <div class="dropdown">
                                <button class="customer-user dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    @(Context.Session.GetString("HoTenKhachHang") ?? "Tài khoản")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="HoSoKhachHang"><i class="bi bi-person"></i> Hồ sơ</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="LichSuDonHang"><i class="bi bi-clock-history"></i> Lịch sử đơn hàng</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="GuestAccount" asp-action="DangXuat"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="customer-login" asp-controller="GuestAccount" asp-action="DangNhap">ĐĂNG NHẬP</a>
                            <a class="customer-register" asp-controller="GuestAccount" asp-action="DangKy">ĐĂNG KÝ</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="customer-footer" id="about">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a class="customer-logo footer-logo" asp-controller="Guest" asp-action="Index">
                        <span class="logo-mark"><i class="bi bi-cup-hot-fill"></i></span>
                        <span>WebCafe<span>Poly</span></span>
                    </a>
                    <p class="footer-desc">Cà phê ngon, không gian đẹp, phục vụ những khoảnh khắc đáng nhớ.</p>
                </div>
                <div>
                    <h5>KHÁM PHÁ</h5>
                    <a asp-controller="Guest" asp-action="Index">Thực đơn</a>
                    <a href="#about">Về chúng tôi</a>
                </div>
                <div>
                    <h5>LIÊN HỆ</h5>
                    <p><i class="bi bi-geo-alt"></i> Đồng Nai, Việt Nam</p>
                    <p><i class="bi bi-telephone"></i> 0123 456 789</p>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.Now.Year WebCafePoly</span>
                <span>Coffee • Tea • Dessert</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
