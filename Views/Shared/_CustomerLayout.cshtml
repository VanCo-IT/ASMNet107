```cshtml
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WebCafePoly</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body>

    <header class="customer-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">

                <a class="navbar-brand customer-logo"
                   asp-controller="Guest"
                   asp-action="Index">
                    <i class="bi bi-cup-hot-fill"></i>
                    WebCafePoly
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#customerNavbar">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse navbar-collapse" id="customerNavbar">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Guest"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Guest"
                               asp-action="Index">
                                Thực đơn
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#about">
                                Về chúng tôi
                            </a>
                        </li>

                    </ul>

                    <div class="customer-account">

                        @if (Context.Session.GetString("MaKhachHang") != null)
                        {
                            <a class="customer-action"
                               asp-controller="Customer"
                               asp-action="GioHang">
                                <i class="bi bi-cart3"></i>
                                Giỏ hàng
                            </a>

                            <div class="dropdown">
                                <button class="customer-user dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    @(Context.Session.GetString("HoTenKhachHang") ?? "Tài khoản")
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Customer"
                                           asp-action="HoSoKhachHang">
                                            <i class="bi bi-person"></i>
                                            Hồ sơ
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Customer"
                                           asp-action="LichSuDonHang">
                                            <i class="bi bi-clock-history"></i>
                                            Lịch sử đơn hàng
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="GuestAccount"
                                           asp-action="DangXuat">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Đăng xuất
                                        </a>
                                    </li>

                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="customer-login"
                               asp-controller="GuestAccount"
                               asp-action="DangNhap">
                                Đăng nhập
                            </a>

                            <a class="customer-register"
                               asp-controller="GuestAccount"
                               asp-action="DangKy">
                                Đăng ký
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="customer-footer" id="about">
        <div class="container">
            <div class="row">

                <div class="col-md-6">
                    <h4>
                        <i class="bi bi-cup-hot-fill"></i>
                        WebCafePoly
                    </h4>

                    <p>
                        Không gian cà phê dành cho những phút giây thư giãn.
                    </p>
                </div>

                <div class="col-md-6 text-md-end">
                    <p class="mb-1">Cà phê • Trà • Nước ép • Bánh</p>
                    <p class="mb-0">© @DateTime.Now.Year WebCafePoly</p>
                </div>

            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
```
