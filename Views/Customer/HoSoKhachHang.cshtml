@model WebCafePoly.Models.KhachHang

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Hồ sơ khách hàng";
}

<section class="profile-page">
    <div class="container py-5">

        <div class="text-center mb-5">
            <h1 class="menu-title">Hồ sơ của tôi</h1>
            <p class="menu-subtitle">Quản lý thông tin tài khoản</p>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-success text-center">
                @ViewBag.ThongBao
            </div>
        }

        <div class="profile-card">

            <div class="profile-icon">
                <i class="bi bi-person-circle"></i>
            </div>

            <form asp-action="HoSoKhachHang" method="post">

                <input asp-for="MaKhachHang" type="hidden" />
                <input asp-for="TrangThai" type="hidden" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="HoTen" class="form-label"></label>
                        <input asp-for="HoTen" class="form-control" />
                        <span asp-validation-for="HoTen" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SoDienThoai" class="form-label"></label>
                        <input asp-for="SoDienThoai" class="form-control" />
                        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DiaChi" class="form-label"></label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="MatKhau" class="form-label"></label>

                        <div class="password-box">
                            <input asp-for="MatKhau"
                                   type="password"
                                   value="@Model.MatKhau"
                                   id="MatKhau"
                                   class="form-control" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword()">
                                <i class="bi bi-eye" id="passwordIcon"></i>
                            </button>
                        </div>

                        <span asp-validation-for="MatKhau" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="showPassword"
                                   onclick="togglePassword()" />

                            <label class="form-check-label" for="showPassword">
                                Hiện mật khẩu
                            </label>
                        </div>
                    </div>

                </div>

                <button type="submit" class="btn btn-order profile-submit">
                    <i class="bi bi-check-circle"></i>
                    Cập nhật thông tin
                </button>

            </form>

        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassword() {
            var input = document.getElementById("MatKhau");
            var checkbox = document.getElementById("showPassword");
            var icon = document.getElementById("passwordIcon");

            if (input.type === "password") {
                input.type = "text";
                checkbox.checked = true;
                icon.className = "bi bi-eye-slash";
            } else {
                input.type = "password";
                checkbox.checked = false;
                icon.className = "bi bi-eye";
            }
        }
    </script>
}